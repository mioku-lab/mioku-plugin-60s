{
  "name": "mioku-plugin-60s",
  "version": "3.0.2",
  "description": "基于 mioku-60s-service 的资讯与实用信息插件",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "mioku"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mioku-lab/mioku-plugin-60s.git"
  },
  "peerDependencies": {
    "mioku": "^1.0.0",
    "mioku-service-60s": "^3.0.0"
  },
  "devDependencies": {
    "mioku": "workspace:*",
    "mioku-service-60s": "workspace:*"
  },
  "mioku": {
    "services": [
      "60s",
      "config",
      "ai",
      "screenshot"
    ],
    "accessHooks": [
      {
        "id": "60s",
        "match": "60s"
      },
      {
        "id": "it",
        "match": "it"
      },
      {
        "id": "金价",
        "match": "金价"
      },
      {
        "id": "油价",
        "match": "/(.+)油价$/"
      },
      {
        "id": "天气",
        "match": "/(.+)天气$/"
      },
      {
        "id": "摸鱼日报",
        "match": "摸鱼日报"
      },
      {
        "id": "epic",
        "match": "epic"
      },
      {
        "id": "历史上的今天",
        "match": "历史上的今天"
      },
      {
        "id": "ai",
        "match": "ai"
      },
      {
        "id": "whois",
        "match": "/^\\/whois\\s+/"
      },
      {
        "id": "热搜",
        "match": "热搜"
      },
      {
        "id": "一言",
        "match": "一言"
      },
      {
        "id": "疯狂星期四",
        "match": "疯狂星期四"
      },
      {
        "id": "答案之书",
        "match": "答案之书"
      },
      {
        "id": "发病",
        "match": "发病"
      }
    ],
    "help": {
      "title": "60s 资讯",
      "description": "调用 60s API 获取新闻、AI、油价、天气、金价等信息",
      "commands": [
        {
          "cmd": "60s",
          "desc": "获取今日 60s 新闻简报",
          "role": "member"
        },
        {
          "cmd": "it",
          "desc": "获取实时 IT 资讯",
          "role": "member"
        },
        {
          "cmd": "金价",
          "desc": "获取黄金价格",
          "role": "member"
        },
        {
          "cmd": "<地区>油价",
          "desc": "获取汽油价格，如：杭州油价",
          "role": "member"
        },
        {
          "cmd": "<地区>天气",
          "desc": "获取实时天气，如：北京天气",
          "role": "member"
        },
        {
          "cmd": "摸鱼日报",
          "desc": "获取摸鱼日报",
          "role": "member"
        },
        {
          "cmd": "epic",
          "desc": "获取 Epic 免费游戏",
          "role": "member"
        },
        {
          "cmd": "历史上的今天",
          "desc": "获取历史上的今天",
          "role": "member"
        },
        {
          "cmd": "ai",
          "desc": "获取 AI 资讯快报",
          "role": "member"
        },
        {
          "cmd": "/whois <域名>",
          "desc": "查询域名 Whois 信息",
          "role": "member"
        },
        {
          "cmd": "热搜",
          "desc": "获取微博、抖音、百度等热搜榜单",
          "role": "member"
        },
        {
          "cmd": "一言",
          "desc": "随机获取一句名言",
          "role": "member"
        },
        {
          "cmd": "疯狂星期四",
          "desc": "获取 KFC 疯狂星期四文案",
          "role": "member"
        },
        {
          "cmd": "答案之书",
          "desc": "随机获取答案",
          "role": "member"
        },
        {
          "cmd": "发病",
          "desc": "生成发病文学",
          "role": "member"
        }
      ]
    }
  }
}
